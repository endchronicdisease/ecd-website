---
import Base from '../layouts/Base.astro';
import rawBody from '../raw/news.body.html?raw';
import style from '../raw/news.style.css?raw';
import extra from '../raw/news.extra.css?raw';
import { loadNews, isoMonth, esc } from '../lib/news.mjs';
import { INSIGHTS } from '../lib/insights.mjs';

// Pre-render the news cards at build time so the stories exist in the HTML for
// crawlers that do not run JavaScript (most AI crawlers, feed readers, link
// previews). The markup below mirrors the card template in /scripts/news.js,
// which re-renders the same list on load and drives the filters.
const { CDN, DATA } = loadNews();
const SITE = 'https://www.endchronicdisease.org';
const BASE_FINISH = 'brightness(1.015) contrast(.972) saturate(.985)';
const finish = (x) => (x ? x + ' ' + BASE_FINISH : BASE_FINISH);
const cards = DATA.map((d) => {
  const img = CDN + d.i, zoom = d.z ? 'scale(1.05) translateY(1.5%)' : 'none', fit = d.f ? 'contain' : 'cover';
  const internal = d.u.charAt(0) === '/';
  const badge = d.k === 'Explainer' ? '<span style="position:absolute;left:12px;top:12px;padding:7px 11px;border-radius:999px;background:#67A081;color:#ffffff;font:600 11.5px/1 \'Graphik\',\'Hanken Grotesk\',sans-serif;letter-spacing:.12em;text-transform:uppercase">From ECD</span>' : '';
  return '<a class="ecd-card" href="' + esc(d.u) + '"' + (internal ? '' : ' target="_blank" rel="noopener"') + ' style="display:block;text-decoration:none">\n' +
    '<span style="display:block;position:relative;background:#E6E2DA;border-radius:12px;overflow:hidden;aspect-ratio:16/10"><img loading="lazy" src="' + esc(img) + '" alt="' + esc(d.o + ': ' + d.t) + '" style="width:100%;height:100%;object-fit:' + fit + ';display:block;transform:' + zoom + ';filter:' + finish(d.x) + '">' + badge + '</span>\n' +
    '<span style="display:block;margin:18px 0 0;line-height:1.45">\n' +
    '<span style="font:600 14.5px/1 \'Graphik\',\'Hanken Grotesk\',sans-serif;letter-spacing:.14em;text-transform:uppercase;color:#6FA4E2">' + esc(d.k) + '</span>\n' +
    '<span aria-hidden="true" style="font:400 14.5px/1 \'Graphik\',\'Hanken Grotesk\',sans-serif;color:#B4AFA6;margin:0 5px">|</span>\n' +
    '<span style="font:500 14.5px/1.45 \'Graphik\',\'Hanken Grotesk\',sans-serif;letter-spacing:.09em;text-transform:uppercase;color:#6B6763">' + esc(d.o) + '</span>\n' +
    '<span style="font:400 14.5px/1.45 \'Graphik\',\'Hanken Grotesk\',sans-serif;color:#757575;white-space:nowrap"><span aria-hidden="true" style="color:#B4AFA6;margin:0 5px">|</span>' + esc(d.d) + '</span>\n' +
    '</span>\n' +
    '<span class="ecd-card-t" style="display:block;margin:10px 0 0;font:600 21px/1.26 \'Graphik\',\'Hanken Grotesk\',sans-serif;letter-spacing:-.014em;color:#757575;text-wrap:pretty">' + esc(d.t) + '</span>\n' +
    '<span class="ecd-card-b" style="display:block;margin:10px 0 0;font:400 17px/1.6 \'Chronicle Display\',\'Newsreader\',Georgia,serif;color:#757575">' + esc(d.b) + '</span>\n' +
    '</a>';
}).join('\n');

// Structured data: the coverage list, each entry a news article about End Chronic Disease.
const ld = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'End Chronic Disease in the news',
  url: SITE + '/news/',
  numberOfItems: DATA.length,
  itemListElement: DATA.map((d, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': d.k === 'Explainer' ? 'Article' : 'NewsArticle',
      headline: d.t,
      description: d.b,
      url: d.u.charAt(0) === '/' ? SITE + d.u : d.u,
      image: SITE + CDN + d.i,
      ...(isoMonth(d.d) ? { datePublished: isoMonth(d.d) } : {}),
      publisher: { '@type': 'Organization', name: d.o },
      about: { '@type': 'Organization', name: 'End Chronic Disease', url: SITE + '/' },
      keywords: d.g.join(', '),
    },
  })),
};
const ldScript = '<script type="application/ld+json">' + JSON.stringify(ld).replace(/</g, '\\u003c') + '</script>\n';


// "From End Chronic Disease" strip: the latest insights, kept outside the press grid and its counts.
const strip = '<div style="padding:0 80px 10px;background:#ffffff">\n<div style="max-width:1192px;margin:0 auto 34px;padding:24px 28px 26px;background:#F0EEE9;border-radius:14px">\n' +
  '<div style="display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:8px 24px">' +
  '<div style="font:600 14px/1 \'Graphik\',\'Hanken Grotesk\',sans-serif;letter-spacing:.14em;text-transform:uppercase;color:#67A081">From End Chronic Disease</div>' +
  '<a href="/insights/" style="font:600 14px/1.4 \'Graphik\',\'Hanken Grotesk\',sans-serif;color:#67A081;text-decoration:none;white-space:nowrap">See all insights &rarr;</a></div>\n' +
  '<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:18px 36px;margin:18px 0 0">' +
  INSIGHTS.slice(0, 2).map((it) => '<a href="' + esc(it.url) + '" style="display:flex;gap:16px;align-items:center;text-decoration:none">' +
    '<span style="flex:none;width:120px;aspect-ratio:16/10;border-radius:8px;overflow:hidden;background:#E6E2DA"><img loading="lazy" src="' + esc(it.image) + '" alt="" style="width:100%;height:100%;object-fit:cover;display:block"></span>' +
    '<span style="min-width:0"><span style="display:block;font:600 16.5px/1.3 \'Graphik\',\'Hanken Grotesk\',sans-serif;letter-spacing:-.012em;color:#757575;text-wrap:pretty">' + esc(it.title) + '</span>' +
    '<span style="display:block;margin:6px 0 0;font:400 13.5px/1.3 \'Graphik\',\'Hanken Grotesk\',sans-serif;color:#848484">' + esc(it.kind || 'Spotlight') + ' &middot; ' + esc(it.month) + '</span></span></a>').join('') +
  '</div>\n</div>\n</div>\n';
const searchBlock = '<div style="padding:0 80px 22px;background:#ffffff">\n<div style="max-width:1192px;margin:0 auto">\n<div style="position:relative;max-width:420px;margin:0 0 26px">';
if (!rawBody.includes(searchBlock)) throw new Error('news.body.html search block changed; update the strip anchor in news.astro');
const itemsTag = '<span id="ecdNewsItems" style="display:contents"></span>';
const summaryTag = /(<div id="ecdNewsSummary"[^>]*>)<\/div>/;
if (!rawBody.includes(itemsTag) || !summaryTag.test(rawBody)) throw new Error('news.body.html placeholders changed; update news.astro');
const body = ldScript + rawBody
  .replace(searchBlock, strip + searchBlock)
  .replace(itemsTag, '<span id="ecdNewsItems" style="display:contents">\n' + cards + '\n</span>')
  .replace(summaryTag, '$1' + DATA.length + ' stories</div>');
---
<Base title='News | End Chronic Disease' description='Press coverage, interviews, and commentary from End Chronic Disease.' css={[style, extra]} scripts={["/scripts/news-data.js", "/scripts/news.js"]}>
  <Fragment set:html={body} />
</Base>
