  author: { '@type': 'Organization', name: 'End Chronic Disease', url: SITE + '/' },
  publisher: { '@type': 'Organization', name: 'End Chronic Disease', url: SITE + '/', logo: { '@type': 'ImageObject', url: SITE + '/assets/logo-full-green.png' } },
  mainEntityOfPage: SITE + '/insights/champions-for-youth-summit-2026/',
  image: SITE + '/assets/photos/news/explainer-cfy-stage.webp',
  about: ['Champions for Youth Summit', 'Arthur Brooks', 'youth health', 'prevention'] };
const body = '<script type="application/ld+json">' + JSON.stringify(ld).replace(/</g, '\\u003c') + '</script>\n' + rawBody;
---
<Base title='Kelly McKenna introduces Arthur Brooks at national youth health summit | End Chronic Disease' shareTitle='Kelly McKenna introduces Arthur Brooks at national youth health summit sponsored by End Chronic Disease' description='At the Champions for Youth Summit in Reston, Virginia, Kelly McKenna on how daily behavior and environment shape chronic disease risk, ahead of Dr. Arthur C. Brooks’s keynote.' css={[style]}>
