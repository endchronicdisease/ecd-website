---
import Base from '../../layouts/Base.astro';
import rawBody from '../../raw/insights-cfy-summit.body.html?raw';
import style from '../../raw/news.style.css?raw';
const SITE = 'https://www.endchronicdisease.org';
const ld = { '@context': 'https://schema.org', '@type': 'Article',
  headline: 'Kelly McKenna introduces Arthur Brooks at national youth health summit sponsored by End Chronic Disease',
  description: 'At the Champions for Youth Summit in Reston, Virginia, Kelly McKenna on how daily behavior and environment shape chronic disease risk, ahead of Dr. Arthur C. Brooks\u2019s keynote.',
