  mainEntityOfPage: SITE + '/insights/dementia-registry-research-2026/',
  image: SITE + '/assets/photos/news/6a82818e554e93b61122c1eb-vecteezy-ai-generated-medical-x-ray-image-of-the-human-brain-close-up-41041981-2.webp',
