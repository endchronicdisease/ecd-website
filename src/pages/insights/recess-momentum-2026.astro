---
import Base from '../../layouts/Base.astro';
import rawBody from '../../raw/insights-recess-momentum.body.html?raw';
import style from '../../raw/news.style.css?raw';
const SITE = 'https://www.endchronicdisease.org';
const ld = { '@context': 'https://schema.org', '@type': 'Article',
  headline: 'Volume on the recess conversation amplifies as parents and policymakers push for more play',
  description: 'New pediatric guidance, a parent-led movement, and landmark laws in Tennessee and Oklahoma are putting unstructured play back on the agenda.',
  datePublished: '2026-08-04', dateModified: '2026-10-22',
  author: { '@type': 'Organization', name: 'End Chronic Disease', url: SITE + '/' },
  publisher: { '@type': 'Organization', name: 'End Chronic Disease', url: SITE + '/', logo: { '@type': 'ImageObject', url: SITE + '/assets/logo-full-green.png' } },
  mainEntityOfPage: SITE + '/insights/recess-momentum-2026/',
  image: SITE + '/assets/photos/news/explainer-hopscotch-chalk.webp',
  about: ['recess', 'physical activity', 'children', 'school policy'] };
const body = '<script type="application/ld+json">' + JSON.stringify(ld).replace(/</g, '\\u003c') + '</script>\n' + rawBody;
---
<Base title='Volume on the recess conversation amplifies as parents and policymakers push for more play | End Chronic Disease' shareTitle='Volume on the recess conversation amplifies as parents and policymakers push for more play' description='New pediatric guidance, a parent-led movement, and landmark laws in Tennessee and Oklahoma are putting unstructured play back on the agenda.' css={[style]}>
  <Fragment set:html={body} />
</Base>
