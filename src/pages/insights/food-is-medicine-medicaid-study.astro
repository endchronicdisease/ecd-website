---
import Base from '../../layouts/Base.astro';
import rawBody from '../../raw/insights-food-is-medicine.body.html?raw';
import style from '../../raw/news.style.css?raw';
const SITE = 'https://www.endchronicdisease.org';
const ld = { '@context': 'https://schema.org', '@type': 'Article',
  headline: 'Groundbreaking \u201cfood is medicine\u201d study reduces hospitalizations among Medicaid recipients by 31%',
