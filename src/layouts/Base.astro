---
import mobile from '../styles/mobile.css?raw';
const { title, description, css = [], scripts = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Netlify sets URL to the site's primary address at build time. Until the
// custom domain is attached that is the netlify.app preview address, and we
// do not want Google indexing the preview alongside the real site. Once
// www.endchronicdisease.org is the primary domain in Netlify, the next deploy
// drops this tag automatically. Local builds (no URL) also get noindex.
const siteUrl = process.env.URL || '';
const noindex = !/endchronicdisease\.org/.test(siteUrl);
// Share images must resolve on the address the page is actually served from: until the
// custom domain is attached, Astro.site (the future domain) still points at the old site.
// The version query makes messaging apps and social networks refetch after a change.
const shareImage = new URL('/assets/og-image.jpg?v=2', siteUrl || Astro.site);
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content="End Chronic Disease" />
<meta property="og:image" content={shareImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Children drawing with chalk on a painted mural wall" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={shareImage} />
<link rel="preload" href="/assets/fonts/Graphik-Regular.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/assets/fonts/Graphik-Semibold.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:ital,wght@0,300..800;1,300..800&family=Newsreader:ital,opsz,wght@0,6..72,200..700;1,6..72,200..700&family=Coming+Soon&display=swap" rel="stylesheet" />
{css.map((c) => <style set:html={c}></style>)}
<style set:html={mobile}></style>
<!-- Analytics: Google Analytics 4 and HubSpot tracking.
     Loaded only on the production domain so Netlify previews and local dev
     do not pollute real traffic data. -->
<script is:inline>
  (function () {
    var host = location.hostname;
    var isProd = host === 'endchronicdisease.org' || host.endsWith('.endchronicdisease.org');
    if (!isProd) return;

    window.dataLayer = window.dataLayer || [];
    window.gtag = function () { dataLayer.push(arguments); };
    gtag('js', new Date());
    gtag('config', 'G-VWQH92XELT');

    var ga = document.createElement('script');
    ga.async = true;
    ga.src = 'https://www.googletagmanager.com/gtag/js?id=G-VWQH92XELT';
    document.head.appendChild(ga);

    var hs = document.createElement('script');
    hs.id = 'hs-script-loader';
    hs.async = true;
    hs.defer = true;
    hs.src = 'https://js-na1.hs-scripts.com/50818861.js';
    document.head.appendChild(hs);
  })();
</script>
</head>
<body>
<slot />
<div id="ecdSearchOverlay" role="dialog" aria-modal="true" aria-label="Search End Chronic Disease">
<div style="box-sizing:border-box;max-width:1352px;margin:0 auto;padding:44px 80px 0">
<div style="display:flex;align-items:center;justify-content:space-between;gap:40px">
<label for="ecdSearchInput" style="font:400 25px/1.2 'Coming Soon',cursive;color:#6FA4E2">Search</label>
<button id="ecdSearchClose" type="button" aria-label="Close search" style="font:600 12.5px/1 'Graphik','Hanken Grotesk',sans-serif;letter-spacing:.14em;text-transform:uppercase;color:#757575;background:none;border:none;padding:10px 0;cursor:pointer">Close</button>
</div>
<div style="display:flex;align-items:center;gap:14px;margin:22px 0 0;padding:0 0 16px;border-bottom:2px solid #DBD6CE">
<span style="flex:none;color:#848484"><svg viewBox="0 0 20 20" width="17" height="17" aria-hidden="true" focusable="false" style="display:block"><circle cx="8.5" cy="8.5" r="5.6" fill="none" stroke="currentColor" stroke-width="1.9"></circle><line x1="12.7" y1="12.7" x2="17.4" y2="17.4" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"></line></svg></span>
<input id="ecdSearchInput" type="search" autocomplete="off" placeholder="Search End Chronic Disease" aria-describedby="ecdSearchCount" style="flex:1;min-width:0;font:400 26px/1.3 'Graphik','Hanken Grotesk',sans-serif;color:#4a4a4a;background:none;border:none;outline:none">
</div>
<div id="ecdSearchCount" role="status" aria-live="polite" style="margin:18px 0 0;font:500 12.5px/1 'Graphik','Hanken Grotesk',sans-serif;letter-spacing:.12em;text-transform:uppercase;color:#848484"></div>
<div id="ecdSearchResults" role="listbox" aria-label="Search results" style="margin:20px 0 0;max-height:calc(100vh - 300px);overflow:auto;padding:0 0 40px"></div>
</div>
</div>
<script src="/scripts/search.js" defer></script>
<script src="/scripts/nav.js" defer></script>
{scripts.map((s) => <script src={s} defer></script>)}
</body>
</html>
